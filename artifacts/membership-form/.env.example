# ─────────────────────────────────────────────────────────────────────────────
# BWYDC Membership Form — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
#
# Copy this file to .env.local for local overrides (never commit .env.local).
#
# VITE_API_URL
#   The base URL of the BWYDC API server.
#   Leave blank when running on Replit (same-origin proxy handles it).
#   Set to your Replit deployment URL when deploying the frontend to Vercel.
#
#   Example:
#     VITE_API_URL=https://bwydc-api.your-username.replit.app
#
VITE_API_URL=
